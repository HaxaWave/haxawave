# (Qualcomm modem_proc sources).
#
# RF card china_v2 (hw_id 151): match the card data to the hardware actually fitted
#
# The china_v2 RF card definition in this December 2014 SDK drop is for a board revision that
# carries an ASM (QFE3320) front-end module and extra tuners. The Wileyfox Swift does not have
# them (confirmed by a live RFFE bus scan and by visual inspection of the board), and the real
# OEM firmware for this same phone uses a card-151 definition with only the 3 devices that are
# actually fitted (WTR4905, QFE2101, QFE2340) plus the matching antenna-switching (GRFC) sequence.
#
# This replaces the stock device list, device count and GSM RX port with the ones the real OEM
# firmware uses, and rewrites the GSM antenna-switching sequence (TIMING_ASM_CTL, which drives the
# missing ASM) with the three RF_PATH_SEL GRFC lines the real firmware uses instead. Matching the
# card's own data to the real hardware is more complete and more narrowly scoped than relaxing the
# missing-device check in the RFC framework shared by every RFC card (rfc.cpp): it also fixes the
# GSM receive sensitivity, which the framework-only fix leaves far below what the real firmware
# reaches on the same board.
--- a/rfc_dimepm/rf_card/rfc_wtr4905_china_v2/common/inc/rfc_wtr4905_china_v2_cmn_ag.h
+++ b/rfc_dimepm/rf_card/rfc_wtr4905_china_v2/common/inc/rfc_wtr4905_china_v2_cmn_ag.h
@@ -56,6 +56,17 @@
   RFC_WTR4905_CHINA_V2_RF_PATH_SEL_09,
   RFC_WTR4905_CHINA_V2_RF_PATH_SEL_06,
   RFC_WTR4905_CHINA_V2_RF_PATH_SEL_11,
+  /* GRFC/PA signals needed to switch the antenna and PA without the ASM
+     (QFE3320) front-end module, which this board does not carry. The
+     physical pin assignment (RFC_MSM_*) and the set of signals used per
+     GSM band come from the real OEM firmware for the same phone, decoded
+     from its rfc_wtr4905_china_v2_sig_info and per-band sig_cfg tables.
+     RFC_MSM_* is the platform-wide pin enum (physical SoC pinout), the
+     same across card SDK versions, so the values port over directly. */
+  RFC_WTR4905_CHINA_V2_RF_PATH_SEL_01,
+  RFC_WTR4905_CHINA_V2_RF_PATH_SEL_07,
+  RFC_WTR4905_CHINA_V2_PA_ON_19,
+  RFC_WTR4905_CHINA_V2_PA0_R0,
   RFC_WTR4905_CHINA_V2_GPDATA0_0,
   RFC_WTR4905_CHINA_V2_RFFE5_CLK,
   RFC_WTR4905_CHINA_V2_RFFE5_DATA,
