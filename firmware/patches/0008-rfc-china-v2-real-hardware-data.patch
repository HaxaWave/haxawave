     RFDEVICE_INVALID, /* PHY_DEVICE_NAME */ 
@@ -239,6 +266,13 @@
     2, /* ASSOCIATED_PHY_DEVICE_INSTANCE */ 
   }, /* END - Device: QFE2340 */ 
 
+/* The logical devices below point at the physical device instances
